<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AulaChatNet.Shared</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sin NoWarn de CS1591: todo el API público está documentado, así que
         con TreatWarningsAsErrors la compilación FALLA si aparece documentación
         XML pendiente (la regla de la casa se autocumple, no se silencia). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Operadores Rx sobre IObservable<MensajeDto> -->
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

</Project>
