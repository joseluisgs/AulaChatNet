@implements IDisposable
@inject IChatStore Store
@inject IJSRuntime JS

@* Aviso de menciones (@ana): el badge contador de la esquina y el
   parpadeo de la pestaña. El EMPUJONCITO viene del servidor por
   MencionRecibida; la store lleva el contador; aquí solo se pinta y se
   habla con el navegador — document.title es JavaScript, y aquí no se
   pinta nada: se le pide al navegador que lo haga. *@
@if (_noVistas > 0)
{
    <button class="mencion-aviso" @onclick="MarcarVistas"
            title="Menciones sin mirar. Pulsa para darlas por vistas">
        💬 @_noVistas
    </button>
}

@code {
    /// <summary>Menciones sin mirar (lee el flujo de la store).</summary>
    private int _noVistas;

    /// <summary>Suscripciones del componente, liberadas en Dispose (convención del proyecto).</summary>
    private readonly List<IDisposable> _suscripciones = [];

    /// <summary>
    /// Se suscribe al contador (para el badge) y a la última mención (para
    /// el parpadeo). Al init, los BehaviorSubject entregan su valor actual:
    /// contador 0 y mención null, que este componente ignora.
    /// </summary>
    protected override void OnInitialized()
    {
        _suscripciones.Add(Store.MencionesNoVistas.Subscribe(n =>
        {
            _noVistas = n;
            _ = InvokeAsync(StateHasChanged);
        }));

        _suscripciones.Add(Store.UltimaMencion.Subscribe(mencion =>
        {
            if (mencion is null)
                return;

            // El parpadeo se PARA SOLO al volver a mirar la pestaña (focus),
            // así que no hay estado que apagar desde aquí
            _ = InvokeAsync(() => JS.InvokeVoidAsync(
                "aulachat.empezarParpadeo",
                $"💬 {mencion.Emisor} te mencionó en {mencion.Canal}"));
        }));
    }

    /// <summary>
    /// El clic del badge apaga DOS cosas: el parpadeo de la pestaña (una
    /// función JS de index.html) y el contador (la store pone el badge a cero).
    /// </summary>
    private async Task MarcarVistas()
    {
        await JS.InvokeVoidAsync("aulachat.terminarParpadeo");
        Store.MarcarMencionesVistas();
    }

    /// <summary>Libera las suscripciones cuando el componente se destruye.</summary>
    public void Dispose()
    {
        foreach (var suscripcion in _suscripciones)
            suscripcion.Dispose();
    }
}
