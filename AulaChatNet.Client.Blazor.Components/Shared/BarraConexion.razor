@* Barra superior (cabecera fija): identidad + punto de estado de la
   conexión + gente de tu sala y en total + Reconectar/Salir.

   Se suscribe a CINCO observables de la store: cada trocito de la barra se
   refresca cuando cambia SU dato. Si la conexión se cae, el punto pasa a
   rojo y aparece el botón Reconectar (el mismo camino que la tecla R de la
   terminal). *@
@implements IDisposable
@inject IChatStore Store

<header class="barra">
    @* Fila de estado: identidad, punto, gente y botones. El error NO va
       aquí — medido, un mensaje de 91 caracteres ocupaba 531 px dentro de
       una fila que necesita 1100 px, y se llevaba los botones fuera de la
       ventana (Salir acababa en el px 1100 de una ventana de 838). *@
    <div class="barra-fila">
        @* Icono de la app: mismo fichero que el panel de entrada (wwwroot/resources) *@
        <img class="barra-icono"
             src="resources/icon-app.png"
             alt="AulaChatNet"
             width="28" height="28" />
        <span class="barra-logo"># AulaChatNet</span>
        <span class="barra-separador">·</span>
        <span class="barra-nick">@(_nick ?? "…")</span>
        <span class="barra-separador">·</span>
        <span class="barra-canal">@(_canal ?? "…")</span>
        <span class="punto @(Punto.Clase)" title="@Punto.Texto"></span>
        <span class="barra-estado">@Punto.Texto</span>

        <span class="barra-contador">
            @_usuarios.Count en la sala · @_estadisticas.TotalConectados en total
        </span>

        @if (_estado == EstadoConexion.Desconectado)
        {
            <button type="button" class="boton-secundario" @onclick="ReconectarAsync">Reconectar</button>
        }

        <button type="button" class="boton-secundario" @onclick="SalirAsync">Salir</button>
    </div>

    @* Mensaje de error en SU línea, a todo el ancho: la fila de arriba queda
       intacta y el texto entero cabe (531 px de texto frente a 806 px
       disponibles), incluso el más largo de 121 caracteres. *@
    @if (_error is not null)
    {
        <div class="barra-error">@_error</div>
    }
</header>

@code {
    private string? _nick;
    private string? _canal;
    private EstadoConexion _estado = EstadoConexion.Desconectado;
    private IReadOnlyList<UsuarioConectadoDto> _usuarios = [];
    private EstadisticasDto _estadisticas = new(0, []);
    private string? _error;

    private readonly CompositeDisposable _suscripciones = new();

    /// <summary>Las cinco suscripciones de la barra (una por dato pintado).</summary>
    protected override void OnInitialized()
    {
        _suscripciones.Add(Store.Nick.Subscribe(valor =>
        {
            _nick = valor;
            _ = InvokeAsync(StateHasChanged);
        }));

        _suscripciones.Add(Store.CanalActual.Subscribe(valor =>
        {
            _canal = valor;
            _ = InvokeAsync(StateHasChanged);
        }));

        _suscripciones.Add(Store.Estado.Subscribe(valor =>
        {
            _estado = valor;
            _error = null; // un estado nuevo borra el error de reconexión anterior
            _ = InvokeAsync(StateHasChanged);
        }));

        _suscripciones.Add(Store.Usuarios.Subscribe(lista =>
        {
            _usuarios = lista;
            _ = InvokeAsync(StateHasChanged);
        }));

        _suscripciones.Add(Store.Estadisticas.Subscribe(est =>
        {
            _estadisticas = est;
            _ = InvokeAsync(StateHasChanged);
        }));
    }

    /// <summary>
    /// Punto de Discord: misma paleta que la terminal (verde conectado, gris
    /// conectando, naranja reconectando, rojo caído) — la clase CSS del punto
    /// y su texto salen del mismo sitio para que no se desincronicen.
    /// </summary>
    private (string Clase, string Texto) Punto => _estado switch
    {
        EstadoConexion.Conectado => ("conectado", "conectado"),
        EstadoConexion.Conectando => ("conectando", "conectando"),
        EstadoConexion.Reconectando => ("reconectando", "reconectando"),
        _ => ("desconectado", "desconectado")
    };

    /// <summary>Reintenta a mano cuando la reconexión automática ya se rindió.</summary>
    private async Task ReconectarAsync()
    {
        // Devuelve null si entró; el error (traducido a palabras de usuario) si no
        _error = await Store.ReconectarAsync();
    }

    /// <summary>Cierra la sesión de forma ordenada: vuelve al panel de entrada.</summary>
    private async Task SalirAsync() => await Store.CerrarAsync();

    /// <summary>Libera las suscripciones cuando el componente se destruye.</summary>
    public void Dispose() => _suscripciones.Dispose();
}
