<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AulaChatNet.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sin NoWarn de CS1591: todo el API público está documentado, así que
         con TreatWarningsAsErrors la compilación FALLA si aparece documentación
         XML pendiente (la regla de la casa se autocumple, no se silencia). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Logging estructurado (estilo Tienda): consola + fichero de errores con rolling -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />

    <!-- Alojamiento del cliente Blazor WASM: UseBlazorFrameworkFiles sirve
         el runtime _framework (wasm, dll, brotli) que genera el proyecto cliente -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />

    <!-- ════════ Persistencia (Fase 2) ════════ -->
    <!-- EF Core + SQLite: la base de datos vive en UN fichero embebido, sin servidor -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />

    <!-- Solo para dotnet ef (migraciones); PrivateAssets evita que viaje al alumno
         en un publish — lo necesita el que DISEÑA el esquema, no quien ejecuta la app -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AulaChatNet.Shared\AulaChatNet.Shared.csproj" />

    <!-- El servidor ALOJA el cliente Blazor WASM: sirve su wwwroot (index.html,
         el runtime _framework y el css) desde la misma URL que el hub, sin CORS -->
    <ProjectReference Include="..\AulaChatNet.Client.Blazor\AulaChatNet.Client.Blazor.csproj" />
  </ItemGroup>

</Project>
