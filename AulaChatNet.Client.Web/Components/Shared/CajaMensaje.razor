@* Caja de texto fija abajo con el placeholder "Escribe un mensaje...".
   Enter o botón envían; la validación local (misma regla que el servidor)
   se pinta AQUÍ, junto al campo. Si lo que falla es la conexión, el aviso
   va al flujo de mensajes (regla de la casa).

   Lo que empieza por "/" no es un mensaje: se parsea con el MISMO parser
   que la terminal (vive en Shared) y lo ejecuta el procesador de comandos
   de la web; sus resultados salen en el flujo de mensajes como avisos.

   MIENTRAS la línea es un privado, salen dos cosas: el chip "Privado a X"
   (que se puede cerrar con ✕) y la nota gris de que no se guarda. Las dos
   se derivan del PARSE de la línea, no de una bandera aparte: así no puede
   quedar un chip diciendo "privado a Ana" cuando la línea ya no lo es.

   ARRIBA del todo, si alguien del canal está escribiendo, sale la línea
   gris con su nombre; se descarta sola a los pocos segundos sin señal. Cada
   tecla avisa a la store de que se está escribiendo, pero el muestreo
   —máximo una señal por segundo al servidor— vive en la store, no aquí. *@
@implements IDisposable
@inject IChatStore Store
@inject ChatConfig Config
@inject IProcesadorComandos Procesador
@inject IJSRuntime JS

<div class="caja-envoltura">
    @if (!string.IsNullOrEmpty(_escribiendo))
    {
        <p class="caja-escribiendo">@_escribiendo</p>
    }

    @if (Destinatario is not null)
    {
        <div class="chip-privado">
            <span>🔒 Privado a <b>@Destinatario</b></span>
            <button type="button"
                    class="chip-cerrar"
                    title="Dejar de escribir el privado"
                    @onclick="CancelarPrivado">✕</button>
        </div>
    }

    <form class="caja" @onsubmit="EnviarAsync" @onsubmit:preventDefault>
        <input id="caja-texto"
               class="caja-entrada"
               placeholder="Escribe un mensaje..."
               maxlength="@Config.MensajeLongitudMaxima"
               autocomplete="off"
               value="@_texto"
               @oninput="ManejarEntrada" />

        <button type="submit"
                class="caja-boton"
                disabled="@string.IsNullOrWhiteSpace(_texto)"
                title="Enviar mensaje">➤</button>
    </form>

    @if (EmpiezaPrivado)
    {
        <p class="caja-nota">@AyudaComandos.NotaPrivados</p>
    }

    @if (_error is not null)
    {
        <p class="caja-aviso">@_error</p>
    }
</div>

@code {
    private string? _texto;
    private string? _error;
    private string? _escribiendo;
    private IDisposable? _suscripcion;
    private IDisposable? _suscripcionPrivado;
    private IDisposable? _suscripcionEscribiendo;

    // Marcador para recuperar el foco tras enviar (se consume en OnAfterRender)
    private bool _focoPendiente;

    /// <summary>
    /// Destinatario de la línea ACTUAL, si es que lo es: se pregunta al
    /// MISMO parser que la va a enviar, así que el chip nunca miente aunque
    /// el usuario edite o borre el destino a mano. Se lee con
    /// DestinatarioDePrivado y no con Parse porque mientras se teclea la
    /// línea aún no es un comando válido — y sin chip no habría ✕ para
    /// cancelar.
    /// </summary>
    private string? Destinatario => ParserComandos.DestinatarioDePrivado(_texto);

    /// <summary>
    /// true mientras la línea va a ser un privado, ANTES de que exista el
    /// destino: es lo que decide cuándo sale la nota de que no se guarda.
    /// </summary>
    private bool EmpiezaPrivado => ParserComandos.EmpiezaPrivado(_texto);

    /// <summary>Tres suscripciones: cambio de canal, clic en la lista y escritura ajena.</summary>
    protected override void OnInitialized()
    {
        _suscripcion = Store.CanalActual.Subscribe(nuevoCanal =>
        {
            _error = null;
            _ = InvokeAsync(StateHasChanged);
        });

        // Un clic en la lista de conectados pide escribirle: aquí se traduce
        // en texto puesto en la caja y foco para seguir escribiendo. null es
        // el valor inicial del sujeto, y significa "no se pidió nada": no se
        // toca lo que el usuario estuviera escribiendo.
        _suscripcionPrivado = Store.DestinatarioPrivado.Subscribe(quien =>
        {
            if (quien is null)
                return;

            _texto = $"/privado {quien} ";
            _focoPendiente = true;
            _ = InvokeAsync(StateHasChanged);
        });

        // "Está escribiendo...": la frase se arma en Shared, así que es
        // literalmente el mismo texto que pinta la terminal, y con la lista
        // vacía no se pinta NADA (una cadena vacía no lleva marca de estilo)
        _suscripcionEscribiendo = Store.Escribiendo.Subscribe(activos =>
        {
            _escribiendo = EscribiendoTexto.Descripcion(activos);
            _ = InvokeAsync(StateHasChanged);
        });
    }

    /// <summary>✕ del chip: se borra la línea y vuelve el placeholder normal.</summary>
    private void CancelarPrivado()
    {
        _texto = "";
        _focoPendiente = true;
    }

    /// <summary>
    /// Cada tecla hace dos cosas: poner el texto en la línea (lo mismo que
    /// haría un @bind) y avisar a la store de que se está escribiendo. Va
    /// aparte de @bind porque Blazor no deja dos manejadores de oninput, y
    /// de paso cubre también pegar y dictar, que son cambios de texto sin
    /// tecla que no saldrían por un onkeydown.
    /// </summary>
    /// <param name="e">Evento con el texto actual del cuadro.</param>
    private void ManejarEntrada(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString();
        Store.SenalarEscritura();
    }

    /// <summary>
    /// Un comando (línea con "/") se ejecuta en el momento y sus resultados
    /// salen en el flujo de mensajes; un texto normal pasa por la validación
    /// local y se envía al canal (Enter o botón ➤).
    /// </summary>
    private async Task EnviarAsync()
    {
        _error = null;

        var texto = _texto?.Trim() ?? string.Empty;

        // Mismo parser que la terminal: "/canal daw" es un comando aquí y
        // allí. El campo se vacía ANTES de ejecutar, para poder seguir
        // escribiendo mientras el comando toca la red o la store
        var comando = ParserComandos.Parse(texto);

        if (comando is not Comando.Enviar)
        {
            _texto = "";
            _focoPendiente = true;
            await Procesador.EjecutarAsync(comando);
            return;
        }

        // Validación local ANTES de tocar la red: mismo criterio que el
        // servidor, para no gastar una ida y vuelta por algo evidente
        var fallo = Config.ValidarMensaje(texto);
        if (fallo is not null)
        {
            _error = fallo;
            return;
        }

        var error = await Store.EnviarAsync(texto);

        if (error is not null)
        {
            // Error de CONEXIÓN → al flujo de mensajes (no es un problema
            // del campo: el campo está perfecto)
            Store.Aviso(error);
            return;
        }

        _texto = "";
        _focoPendiente = true;
    }

    /// <summary>Tras repintar, devuelve el foco al cuadro (para seguir escribiendo).</summary>
    protected override async Task OnAfterRenderAsync(bool primero)
    {
        if (!_focoPendiente)
            return;

        _focoPendiente = false;
        await JS.InvokeVoidAsync("aulachat.enfocar", "caja-texto");
    }

    /// <summary>Libera las tres suscripciones cuando el componente se destruye.</summary>
    public void Dispose()
    {
        _suscripcion?.Dispose();
        _suscripcionPrivado?.Dispose();
        _suscripcionEscribiendo?.Dispose();
    }
}
