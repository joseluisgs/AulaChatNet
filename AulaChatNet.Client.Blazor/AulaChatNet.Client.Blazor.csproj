<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AulaChatNet.Client.Blazor</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sin NoWarn de CS1591: todo el API público está documentado, así que
         con TreatWarningsAsErrors la compilación FALLA si aparece documentación
         XML pendiente (la regla de la casa se autocumple, no se silencia). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Blazor WASM + conexión al ChatHub + capa reactiva -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="System.Reactive" />

    <!-- Configuración: lee wwwroot/appsettings.json (sección Chat, AvatarBaseUrl) -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />

    <!-- Logging: Serilog a la consola del navegador (BrowserConsole, vía JS;
         el sink de consola normal no sirve en WASM) -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.BrowserConsole" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AulaChatNet.Shared\AulaChatNet.Shared.csproj" />
  </ItemGroup>

  <!--
    Favicon: wwwroot/favicon.ico (copia del maestro resources/icon-app.ico).
    No hay que declarar nada: el propio SDK mete todo wwwroot\** como static
    web asset en tiempo de evaluación, así que se sirve en /favicon.ico y sale
    en la publicación sin MSBuild a medida.
  -->

</Project>
