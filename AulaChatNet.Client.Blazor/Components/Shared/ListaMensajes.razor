@* Historial del canal + privados: lo pinta la store (mensajes en vivo) y hace
   scroll automático abajo cuando algo nuevo entra — incluido el reemplazo del
   historial al cambiar de canal.
   Los privados NO van en otra lista aparte: se mezclan en la MISMA
   cronología que el canal, con CombinadorChat (Shared), para que la web y la
   terminal enseñen el mismo rato de charla en el mismo orden. *@
@implements IDisposable
@inject IChatStore Store
@inject IJSRuntime JS

<div class="mensajes" id="lista-mensajes">
    @foreach (var fila in _filas)
    {
        @* El pattern matching no es por estética: al extraer el valor en la
           condición, el compilador SABE que no es null y no hace falta
           ni un "!" ni un aviso de nulabilidad *@
        @if (fila.EsPrivado && fila.Privado is { } privado)
        {
            <PrivadoItem Privado="privado" @key="privado.Id" />
        }
        else if (fila.Mensaje is { } mensaje)
        {
            <MensajeItem Mensaje="mensaje"
                         Reacciones="ChipsDe(mensaje.Id)"
                         Nick="@_nick"
                         @key="mensaje.Id" />
        }
    }

    @if (_filas.Count == 0)
    {
        <p class="mensajes-vacio">
            Todavía no hay mensajes en este canal. ¡Sé el primero en saludar! 👋
        </p>
    }
</div>

@code {
    private IReadOnlyList<MensajeDto> _mensajes = [];
    private IReadOnlyList<MensajePrivadoDto> _privados = [];
    private IReadOnlyDictionary<Guid, ReaccionesMensajeDto> _reacciones = new Dictionary<Guid, ReaccionesMensajeDto>();
    private string? _nick;
    private IReadOnlyList<FilaChat> _filas = [];

    private IDisposable? _suscripcion;
    private IDisposable? _suscripcionPrivados;
    private IDisposable? _suscripcionReacciones;
    private IDisposable? _suscripcionNick;

    // Marcador: "hay que bajar el scroll" — se consume en OnAfterRender
    // (el DOM solo ya está listo a partir de AHÍ, antes no)
    private bool _pendienteBajar;

    /// <summary>Cuatro suscripciones: canal, privados, reacciones y nick.</summary>
    protected override void OnInitialized()
    {
        _suscripcion = Store.Mensajes.Subscribe(mensajes =>
        {
            _mensajes = mensajes;
            Recalcular();
        });

        _suscripcionPrivados = Store.Privados.Subscribe(privados =>
        {
            _privados = privados;
            Recalcular();
        });

        // Las reacciones NO reordenan nada (el orden de las filas no
        // cambia), así que con repintar basta — y sin bajar el scroll: una
        // reacción no debe arrastrar la vista de quien estaba leyendo
        _suscripcionReacciones = Store.Reacciones.Subscribe(reacciones =>
        {
            _reacciones = reacciones;
            _ = InvokeAsync(StateHasChanged);
        });

        // El nick decide qué chip sale resaltado como propio; llega tarde
        // (tras el alta) y puede cambiar con /nick, así que también se suscribe
        _suscripcionNick = Store.Nick.Subscribe(nick =>
        {
            _nick = nick;
            _ = InvokeAsync(StateHasChanged);
        });
    }

    /// <summary>Chips de UN mensaje: los del mapa de reacciones, o vacío.</summary>
    /// <param name="idMensaje">Mensaje a mirar.</param>
    /// <returns>Sus reacciones actuales (lista vacía si no tiene ninguna).</returns>
    private IReadOnlyList<ReaccionDto> ChipsDe(Guid idMensaje) =>
        _reacciones.TryGetValue(idMensaje, out var estado) ? estado.Reacciones : [];

    /// <summary>
    /// Vuelve a ordenar las dos vistas juntas y pide un repintado: es el
    /// único punto donde se decide el orden de la mezcla, para que el canal
    /// y los privados no se ordenen nunca por caminos distintos.
    /// </summary>
    private void Recalcular()
    {
        _filas = CombinadorChat.Combinar(_mensajes, _privados);
        _pendienteBajar = true;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Tras repintar, baja el scroll si había algo nuevo.</summary>
    protected override async Task OnAfterRenderAsync(bool primero)
    {
        if (!_pendienteBajar)
            return;

        _pendienteBajar = false;
        await JS.InvokeVoidAsync("aulachat.abajo", "lista-mensajes");
    }

    /// <summary>Libera las cuatro suscripciones cuando el componente se destruye.</summary>
    public void Dispose()
    {
        _suscripcion?.Dispose();
        _suscripcionPrivados?.Dispose();
        _suscripcionReacciones?.Dispose();
        _suscripcionNick?.Dispose();
    }
}
