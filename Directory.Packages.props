<Project>
  <!--
    Versiones centralizadas de paquetes NuGet (Central Package Management).
    Los .csproj referencian paquetes SIN versión; la única fuente de verdad es este fichero.
    Versiones alineadas con el proyecto de referencia TiendaDawApi-NetCore (.NET 10).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- ══════════════ Clientes ══════════════ -->
    <!-- SignalR: cliente compartido por Terminal y Blazor (10.0.13: incluye el parche de GHSA-334f-vvp4-7g6p) -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />

    <!-- Configuración de clientes (appsettings.json de cada proyecto) -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />

    <!-- Rx.NET: capa reactiva (mensajes entrantes como IObservable) -->
    <PackageVersion Include="System.Reactive" Version="6.0.1" />

    <!-- Spectre.Console: UI de terminal elegante (paneles, colores, Live) -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />

    <!-- Blazor WebAssembly (10.0.13: misma línea parcheada que SignalR.Client) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />

    <!-- Componentes Blazor para la Razor Class Library compartida (Client.Web):
         la usan el host WebAssembly Y el de escritorio (WPF con BlazorWebView),
         así que NO se referencia el shared framework Microsoft.AspNetCore.App
         (un FrameworkReference rompe la compilación WASM con NETSDK1082) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />

    <!-- Blazor Hybrid en la app de escritorio (Fase 5.2): trae el BlazorWebView
         de WPF y el runtime embebido; versión 10.0.120 de la línea 10.0.12
         (este paquete versiona por minor, no por patch como el resto) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
  </ItemGroup>

  <ItemGroup>
    <!-- ══════════════ Logging (Serilog en servidor, terminal y Blazor) ══════════════ -->
    <!-- Núcleo: el servidor lo trae con Serilog.AspNetCore; terminal y Blazor lo usan directo -->
    <PackageVersion Include="Serilog" Version="4.3.0" />

    <!-- Logging estructurado del servidor (estilo Tienda): consola + fichero de errores con rolling -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Puente ILogger<T> → Serilog (AddSerilog en el cliente Blazor; el servidor ya lo incluye en AspNetCore) -->
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />

    <!-- Sink del navegador (Blazor WASM): escribe en la consola del navegador vía JS;
         WriteTo.Console no funciona en WASM (no hay terminal que detectar) -->
    <PackageVersion Include="Serilog.Sinks.BrowserConsole" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ══════════════ Persistencia (Fase 2: SQLite + EF Core) ══════════════ -->
    <!-- EF Core alineado en 10.0.13 con la línea de ASP.NET Core/SignalR del proyecto
         (la Tienda usa 10.0.12; aquí se sube al mismo parche 10.0.13 por coherencia) -->

    <!-- Núcleo del ORM: DbContext, DbSets y el proveedor relacional -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />

    <!-- Proveedor SQLite: la base de datos embebida en un solo fichero, sin servidor.
         Trae dos transitivos que conviene conocer: Microsoft.Data.Sqlite.Core (el
         gestor de conexión) y SQLitePCLRaw.bundle_e_sqlite3 (el MOTOR nativo de SQLite) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />

    <!-- Herramientas de diseño (dotnet ef migrations add...). SOLO desarrollo:
         PrivateAssets evita que se empaquete junto con el proyecto -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>

  <ItemGroup>
    <!-- ══════════════ Testing (NUnit, estilo Tienda) ══════════════ -->
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />

    <!-- Reloj virtual para tests de Rx (TestScheduler): el tiempo pasa al
         instante, sin esperas reales. Misma versión que System.Reactive -->
    <PackageVersion Include="Microsoft.Reactive.Testing" Version="6.0.1" />

    <!-- bUnit: pruebas de componentes Blazor (los stores se prueban con NUnit solo) -->
    <PackageVersion Include="bunit" Version="2.11.3" />
  </ItemGroup>
</Project>
